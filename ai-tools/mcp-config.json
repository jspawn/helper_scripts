{
  "mcpServers": {
    "local-rag": {
      "command": "uvx",
      "args": ["mcp-local-rag"],
      "env": {
        "BASE_DIR": "/srv/llama/rag"
      }
    },
    "searxng": {
      "command": "npx",
      "args": ["-y", "@iflow-mcp/searxng-mcp"],
      "env": {
        "SEARXNG_URL": "http://localhost:8888"
      }
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    }
  }
}
